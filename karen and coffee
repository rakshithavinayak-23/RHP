#include <iostream>
#include <vector>

using namespace std;

const int MAX_TEMP = 200000;
int diff_arr[MAX_TEMP + 2];
int admissible[MAX_TEMP + 2];
int pref[MAX_TEMP + 2];

int main() {
    
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, k, q;
    cin >> n >> k >> q;

    
    for (int i = 0; i < n; ++i) {
        int l, r;
        cin >> l >> r;
        diff_arr[l]++;
        diff_arr[r + 1]--;
    }

    
    int current_recipes = 0;
    for (int i = 1; i <= MAX_TEMP; ++i) {
        current_recipes += diff_arr[i];
        if (current_recipes >= k) {
            admissible[i] = 1;
        } else {
            admissible[i] = 0;
        }
    }

    
    for (int i = 1; i <= MAX_TEMP; ++i) {
        pref[i] = pref[i - 1] + admissible[i];
    }

    
    for (int i = 0; i < q; ++i) {
        int a, b;
        cin >> a >> b;
        cout << pref[b] - pref[a - 1] << "\n";
    }

    return 0;
}
