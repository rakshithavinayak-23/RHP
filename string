#include <iostream>
#include <string>
using namespace std;

int main() {
    string s;
    cin >> s;

    int l = s.length();

    for (int c = 1; c < (1 << l); c++) {
        string combi = "";

        for (int sh = 0; sh < l; sh++) {
            if ((c & (1 << sh)) > 0) {
                combi += s[sh];
            }
        }

        cout << combi << endl;
    }

    return 0;
}
